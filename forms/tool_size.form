<?xml version="1.0" encoding="UTF-8"?>
<!-- The custom tool size dialog's content. EditorDialog sets the field's
   range and value from the current ink and adds OK and Cancel. -->
<panel xmlns="urn:gui-forms:form:1" id="tool-size-form">
  <label id="custom-tool-size-label" text="Size in pixels" bounds="24 54 160 28"/>
  <numeric-up-down id="custom-tool-size" bounds="196 54 136 30"/>
</panel>
