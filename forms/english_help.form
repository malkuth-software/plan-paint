<?xml version="1.0" encoding="UTF-8"?>
<!-- The "Help! English!" recovery dialog's content. Its text is never
   translated: it is the way back to English from any language. EditorDialog
   adds OK and Cancel. -->
<panel xmlns="urn:gui-forms:form:1" id="english-help-form">
  <label id="english-help-question" text="Is English your language?" bounds="24 56 422 30"/>
  <label id="english-help-instructions"
      text="Click OK to use English, then restart Plan Paint.&#10;Your picture stays open so you can save it first."
      bounds="24 96 422 62"/>
</panel>
