// Version and vendor resource for plan-paint.exe; CMake fills the version.
#include <winver.h>

1 VERSIONINFO
FILEVERSION @PAINT_VERSION_MAJOR@,@PAINT_VERSION_MINOR@,@PAINT_VERSION_PATCH@,0
PRODUCTVERSION @PAINT_VERSION_MAJOR@,@PAINT_VERSION_MINOR@,@PAINT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Malkuth Software"
      VALUE "FileDescription", "Plan Paint"
      VALUE "FileVersion", "@PAINT_RELEASE_VERSION@"
      VALUE "InternalName", "plan-paint"
      VALUE "OriginalFilename", "plan-paint.exe"
      VALUE "ProductName", "Plan Paint"
      VALUE "ProductVersion", "@PAINT_RELEASE_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
